# ==============================================================================
# Sentinel-2 Remote Sensing & Deforestation Analysis Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Never commit your actual .env file with secrets into version control!
# ==============================================================================

# Google Earth Engine Configuration
# Specify your authenticated Google Cloud Project ID for Earth Engine
GEE_PROJECT=boxwood-well-512915-r3

# Email Notification Configuration (Optional)
# If using Gmail, generate an App Password at:
# https://myaccount.google.com/apppasswords (Requires 2-Step Verification)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
EMAIL_SUBJECT=Sentinel-2 Deforestation & Forest Analysis Report
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Copernicus Data Space Ecosystem / Sentinel Hub (Optional)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_ACCESS_TOKEN=
